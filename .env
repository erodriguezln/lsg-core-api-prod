# Rutas
# Ruta absoluta en la VM donde queda el código + compose
APP_PATH=/home/DIINF/usuario/lsg-core-api-diinf

# Base de datos (MySQL 8)
MYSQL_ROOT_PASSWORD=change_me_root_password
DB_NAME=db_lsg
DB_USER=lsg_user
DB_PASSWORD=userpassword

# Red y puertos
# Puerto HOST donde la API queda escuchando (para Nginx reverse proxy)
API_PORT=8012

# JWT
# Generar con: python app/tools/generate_jwt_secret.py
AUTH_JWT_SECRET=xaA38suwZjN-W0G658G307tmxrXG5tLN8h0v77BHFmWpk9pt1DNrC3tEURiCqvyzDbd8_UuIPeIQvNLuDEm8nw
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ISSUER=lsg-auth
AUTH_JWT_AUDIENCE=lsg-core-api

# Guards de autenticación
# AUTH_DISABLED=true  → admin ficticio sin validar token (SOLO desarrollo local)
AUTH_DISABLED=false
# AUTH_OPEN_ALL=true  → bypass de verificación de roles (SOLO staging inicial)
# En producción SIEMPRE debe ser false.
AUTH_OPEN_ALL=false

# FastAPI
# Prefix para reverse proxy Nginx
LSG_CORE_API_ROOT_PATH=/lsg-core-api

# Metadata visible en /meta/info y en Swagger
API_VERSION=1.2.0
APP_ENV=production
GIT_COMMIT=HEAD

# Research / Exportación
# Salt para seudonimización de participantes en exportaciones.
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
# IMPORTANTE: cambiar este valor invalida todos los pseudónimos existentes.
RESEARCH_PSEUDONYM_SALT=change_me_random_hex_64_chars

# Offline points
# Ventana máxima de aceptación para eventos generados sin conexión (días).
OFFLINE_SYNC_MAX_AGE_DAYS=30
